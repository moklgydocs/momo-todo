<Window x:Class="MokReport.Todo.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MokReport.Todo.Models"
        Title="新建任务" Width="440" Height="680"
        ResizeMode="NoResize" Background="{StaticResource CardBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Margin="0,8,0,16">
            <TextBlock x:Name="DialogTitle" Text="✨ 新建任务" FontSize="22"
                       FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        </Grid>

        <!-- Form Fields (scrollable) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>

        <!-- Title -->
        <TextBlock Text="任务名称" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="TitleBox" Height="42" FontSize="14"
                 Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                 Padding="14,10" Margin="0,0,0,14"/>

        <!-- Description -->
        <TextBlock Text="任务描述" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="DescBox" Height="64" FontSize="14"
                 Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                 Padding="14,10" TextWrapping="Wrap" AcceptsReturn="True"
                 Margin="0,0,0,14"/>

        <!-- Category + Priority Row -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="📂 分类" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="CategoryBox" Height="42" FontSize="13"
                          ItemsSource="{x:Static models:TodoItem.Categories}" SelectedIndex="0"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="🚩 优先级" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="PriorityBox" Height="42" FontSize="13" SelectedIndex="0">
                    <ComboBoxItem Content="⚪ 低"/>
                    <ComboBoxItem Content="🟡 中"/>
                    <ComboBoxItem Content="🔴 高"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Due Date -->
        <TextBlock Text="📅 截止日期" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="DueDatePicker" Grid.Column="0" Height="42"/>
            <Button Grid.Column="2" Height="42" Width="56"
                    Content="清除" Click="ClearDue_Click"
                    Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                    FontSize="12" Cursor="Hand"/>
        </Grid>

        <!-- Reminder Time -->
        <TextBlock Text="⏰ 提醒时间" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ReminderHour" Height="42" FontSize="13"
                      Grid.Column="0" SelectedIndex="8">
                <ComboBoxItem>00时</ComboBoxItem>
                <ComboBoxItem>01时</ComboBoxItem> <ComboBoxItem>02时</ComboBoxItem>
                <ComboBoxItem>03时</ComboBoxItem> <ComboBoxItem>04时</ComboBoxItem>
                <ComboBoxItem>05时</ComboBoxItem> <ComboBoxItem>06时</ComboBoxItem>
                <ComboBoxItem>07时</ComboBoxItem> <ComboBoxItem>08时</ComboBoxItem>
                <ComboBoxItem>09时</ComboBoxItem> <ComboBoxItem>10时</ComboBoxItem>
                <ComboBoxItem>11时</ComboBoxItem> <ComboBoxItem>12时</ComboBoxItem>
                <ComboBoxItem>13时</ComboBoxItem> <ComboBoxItem>14时</ComboBoxItem>
                <ComboBoxItem>15时</ComboBoxItem> <ComboBoxItem>16时</ComboBoxItem>
                <ComboBoxItem>17时</ComboBoxItem> <ComboBoxItem>18时</ComboBoxItem>
                <ComboBoxItem>19时</ComboBoxItem> <ComboBoxItem>20时</ComboBoxItem>
                <ComboBoxItem>21时</ComboBoxItem> <ComboBoxItem>22时</ComboBoxItem>
                <ComboBoxItem>23时</ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="ReminderMin" Height="42" FontSize="13"
                      Grid.Column="2" SelectedIndex="0">
                <ComboBoxItem>00分</ComboBoxItem>
                <ComboBoxItem>15分</ComboBoxItem>
                <ComboBoxItem>30分</ComboBoxItem>
                <ComboBoxItem>45分</ComboBoxItem>
            </ComboBox>
            <Button Grid.Column="4" Height="42" Width="56"
                    Content="清除" Click="ClearReminder_Click"
                    Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                    FontSize="12" Cursor="Hand"/>
        </Grid>

        <!-- Quick Reminder Presets -->
        <WrapPanel Margin="0,0,0,8">
            <Button Height="32" Width="Auto" Padding="12,0"
                    Content="5分钟后" Click="QuickReminder_Click" Tag="5"
                    FontSize="12" Cursor="Hand"
                    Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                    Margin="0,0,6,6"/>
            <Button Height="32" Width="Auto" Padding="12,0"
                    Content="30分钟后" Click="QuickReminder_Click" Tag="30"
                    FontSize="12" Cursor="Hand"
                    Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                    Margin="0,0,6,6"/>
            <Button Height="32" Width="Auto" Padding="12,0"
                    Content="1小时后" Click="QuickReminder_Click" Tag="60"
                    FontSize="12" Cursor="Hand"
                    Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                    Margin="0,0,6,6"/>
            <Button Height="32" Width="Auto" Padding="12,0"
                    Content="明天9点" Click="QuickReminder_Click" Tag="tomorrow9"
                    FontSize="12" Cursor="Hand"
                    Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                    Margin="0,0,6,6"/>
        </WrapPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons (always visible at bottom) -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Button x:Name="SaveButton" Content="💾 保存任务" Click="SaveButton_Click"
                    Height="48" FontSize="16" FontWeight="SemiBold"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"/>
            <Button Content="取消" Click="CancelButton_Click"
                    Height="40" FontSize="13"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
