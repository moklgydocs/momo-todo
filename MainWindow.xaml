<Window x:Class="MokReport.Todo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MokReport.Todo.Models"
        xmlns:local="clr-namespace:MokReport.Todo"
        Height="700" Width="480"
        MinHeight="560" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei, sans-serif"
        FontSize="14"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Week day button style -->
        <Style x:Key="WeekDayBtn" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="4,6">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="dateNum" Text="{TemplateBinding Tag}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
            </Setter.Value>
        </Setter>
        </Style>

        <!-- Small action button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FCE4EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Main Content Area ===== -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Row 1: Top Bar ===== -->
            <Grid Grid.Row="0" Height="48" Background="{StaticResource BgBrush}" Margin="0"
                      MouseLeftButtonDown="TopBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Momo Todo" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="FocusButton" Content="🧘 专注" Click="FocusButton_Click"
                            Height="30" FontSize="11" Cursor="Hand"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Padding="8,0" Margin="0,0,2,0"
                            ToolTip="开始专注">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="15" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FCE4EC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CalendarToggle" Content="📅" Click="CalendarToggle_Click"
                            Height="30" Width="30" FontSize="14" Cursor="Hand"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Margin="0,0,2,0" ToolTip="日历视图">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FCE4EC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="PinButton" Content="📌" Click="PinButton_Click"
                            Height="30" Width="30" FontSize="14" Cursor="Hand"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Margin="0,0,2,0" ToolTip="置顶窗口">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FCE4EC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="─" Click="Min_Click"
                            Height="30" Width="30" FontSize="14" Cursor="Hand"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Margin="0,0,2,0" ToolTip="最小化">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FCE4EC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="✕" Click="Close_Click"
                            Height="30" Width="30" FontSize="14" Cursor="Hand"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" ToolTip="退出">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Divider -->
            <Border Grid.Row="0" Height="0.5" Background="#18D4687B" VerticalAlignment="Bottom"/>

            <!-- ===== Row 1b: Month Navigation ===== -->
            <Grid Grid.Row="1" Margin="16,8,16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="‹" Click="PrevMonth_Click"
                        Height="28" Width="28" FontSize="18" FontWeight="Bold" Cursor="Hand"
                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="MonthLabel" Text="2026年6月" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WeekLabel" Text=" 第1周" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="今天" Click="Today_Click"
                        Height="28" FontSize="11" Cursor="Hand" Margin="0,0,6,0"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Padding="12,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="3" Content="›" Click="NextMonth_Click"
                        Height="28" Width="28" FontSize="18" FontWeight="Bold" Cursor="Hand"
                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ===== Row 2: Week Date Bar ===== -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="12,0,12,8">
                <Grid x:Name="WeekBar" HorizontalAlignment="Stretch">
                    <!-- 7 day buttons generated in code-behind -->
                </Grid>
            </ScrollViewer>

            <!-- ===== Row 3: Task List ===== -->
            <Grid x:Name="ListView" Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Category filter pills (compact) -->
                    <Border Grid.Row="0" Margin="16,0,16,4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CategoryPills" Orientation="Horizontal">
                                <Button x:Name="CatAll" Content="全部" Click="CategoryFilter_Click" Tag=""
                                        FontSize="11" Cursor="Hand" Height="26" Padding="10,0" Margin="0,0,4,0"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="10,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Quick Search -->
                    <Grid Grid.Row="1" Margin="16,0,16,8">
                        <TextBox x:Name="SearchBox" Height="34" FontSize="13"
                                 TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,0">
                                        <Grid>
                                            <TextBlock x:Name="Placeholder" Text="🔍 搜索任务..."
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"
                                                       Visibility="Collapsed"/>
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>

                    <!-- Task List -->
                    <ScrollViewer x:Name="TaskScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TaskList" Margin="0,0,4,0">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type local:GroupHeader}">
                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="16,12,16,4"/>
                                </DataTemplate>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TaskCard}"
                                            MouseLeftButtonDown="TaskCard_Click" Tag="{Binding Id}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                      IsChecked="{Binding IsCompleted}"
                                                      Checked="TaskCheckBox_Changed"
                                                      Unchecked="TaskCheckBox_Changed"
                                                      Tag="{Binding Id}"
                                                      Style="{StaticResource CuteCheckBox}"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="4" Height="4" CornerRadius="2"
                                                            Background="{Binding ColorBrush}" VerticalAlignment="Center"
                                                            Margin="0,0,6,0" ToolTip="{Binding ColorName}"/>
                                                    <TextBlock Text="{Binding PriorityLabel}" FontSize="11"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Category}" FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                                           MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="📅 " FontSize="11"/>
                                                    <TextBlock Text="{Binding DueDateFormatted}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="  ⏰ " FontSize="11" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding ReminderFormatted}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Content="✏️"
                                                        Click="EditButton_Click" Tag="{Binding Id}" ToolTip="编辑"/>
                                                <Button Style="{StaticResource IconButton}" Content="🗑️"
                                                        Click="DeleteButton_Click" Tag="{Binding Id}"
                                                        ToolTip="删除" Foreground="#EF4444"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Quick Add + Add Button -->
                    <Grid Grid.Row="3" Margin="16,6,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickAddBox" Grid.Column="0" Height="40" FontSize="14"
                                 KeyDown="QuickAdd_KeyDown" VerticalContentAlignment="Center">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,0">
                                        <Grid>
                                            <TextBlock x:Name="Placeholder" Text="＋ 快速添加任务..." FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Visibility="Collapsed"/>
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button Grid.Column="1" Content="＋" Click="AddButton_Click"
                                Height="40" Width="40" FontSize="20" Cursor="Hand"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                BorderThickness="0" Margin="8,0,0,0" ToolTip="新建任务">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.15" Color="#D4687B"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

            </Grid>

            <!-- ===== Bottom Bar ===== -->
        <Border Grid.Row="1" Background="{StaticResource BgBrush}"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Task counts -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TodayCount" Text="今 0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TotalCount" Text="总 0" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Quote -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Orientation="Horizontal">
                    <TextBlock Text="💬" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="QuoteText" Text="" FontSize="12" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                </StackPanel>

                <!-- Refresh + Startup -->
                <Button Grid.Column="2" Width="28" Height="28" Cursor="Hand"
                        Click="RefreshButton_Click" ToolTip="换一句"
                        Background="Transparent" BorderThickness="0" Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <TextBlock Text="🔄" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="StartupButton" Grid.Column="3" Click="StartupButton_Click"
                        Width="28" Height="28" Cursor="Hand" ToolTip="开机自启"
                        Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <TextBlock Text="🚀" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Toast Notification ===== -->
        <Border x:Name="ToastPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,60,0,0" Panel.ZIndex="999"
                CornerRadius="12" Padding="16,12" MinWidth="240" MaxWidth="380">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ToastText" Text="" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ===== Edit Dialog Overlay ===== -->
        <Border x:Name="EditOverlay" Visibility="Collapsed" Panel.ZIndex="1000"
                Background="#80000000" MouseLeftButtonDown="EditOverlayBg_Click">
            <Border x:Name="EditDialog" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="380" MaxHeight="560" Background="White" CornerRadius="20" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="20,16,20,8">
                        <TextBlock x:Name="EditTitle" Text="新建任务" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="✕" Click="EditCancel_Click" HorizontalAlignment="Right"
                                FontSize="16" Cursor="Hand" Background="Transparent"
                                Foreground="#999" BorderThickness="0" Width="28" Height="28">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Date row -->
                    <Grid Grid.Row="1" Margin="20,0,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="EditDuePicker" Grid.Column="0" Height="38" Margin="0"/>
                        <Button Grid.Column="1" Content="今天" Click="EditToday_Click"
                                Height="28" FontSize="11" Cursor="Hand" Margin="8,0,4,0"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0" Padding="10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="10,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Color Picker -->
                    <ItemsControl x:Name="ColorPicker" Grid.Row="2" Margin="20,0,20,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Title -->
                    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                            CornerRadius="10" Margin="20,0,20,12">
                        <TextBox x:Name="EditTitleBox" Height="44" FontSize="15"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Padding="14,0"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- Description -->
                    <Grid Grid.Row="4" Margin="20,0,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="描述" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="DescPreviewToggle" Content="预览" Click="DescPreviewToggle_Click"
                                    Height="22" FontSize="10" Cursor="Hand" Margin="8,0,0,0" Padding="8,0"
                                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="8,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                                CornerRadius="10" MinHeight="60">
                            <Grid>
                                <TextBox x:Name="EditDescBox" FontSize="13"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="14,10" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         MinHeight="60"/>
                                <ContentControl x:Name="DescPreview" Visibility="Collapsed"
                                                Margin="4"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Category + Priority -->
                    <Grid Grid.Row="5" Margin="20,0,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="EditCategoryBox" Grid.Column="0" Height="38"
                                  ItemsSource="{x:Static models:TodoItem.Categories}" SelectedIndex="0"/>
                        <ComboBox x:Name="EditPriorityBox" Grid.Column="2" Height="38" SelectedIndex="1">
                            <ComboBoxItem>⚪ 低</ComboBoxItem>
                            <ComboBoxItem>🟡 中</ComboBoxItem>
                            <ComboBoxItem>🔴 高</ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <!-- Repeat + Defer -->
                    <Grid Grid.Row="6" Margin="20,0,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔁 重复" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="EditRepeatBox" Height="38" SelectedIndex="0">
                                <ComboBoxItem>不重复</ComboBoxItem>
                                <ComboBoxItem>每天</ComboBoxItem>
                                <ComboBoxItem>每周</ComboBoxItem>
                                <ComboBoxItem>每月</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="⏰ 延期" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="EditDeferBox" Height="38" SelectedIndex="0">
                                <ComboBoxItem>默认</ComboBoxItem>
                                <ComboBoxItem>不延期</ComboBoxItem>
                                <ComboBoxItem>自动延期</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Reminder Toggle -->
                    <CheckBox x:Name="ReminderToggle" Grid.Row="7"
                              Content="⏰ 设置提醒" FontSize="13" Cursor="Hand"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Style="{StaticResource CuteCheckBox}" Margin="20,0,20,8"
                              Checked="ReminderToggle_Changed" Unchecked="ReminderToggle_Changed"/>

                    <!-- Reminder Controls -->
                    <Border x:Name="ReminderPanel" Grid.Row="8" Visibility="Collapsed"
                            Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14" Margin="20,0,20,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="EditReminderDate" Grid.Column="0" Height="36"/>
                                <ComboBox x:Name="EditReminderHour" Grid.Column="2" Height="36" SelectedIndex="8">
                                    <ComboBoxItem>00</ComboBoxItem><ComboBoxItem>01</ComboBoxItem><ComboBoxItem>02</ComboBoxItem><ComboBoxItem>03</ComboBoxItem>
                                    <ComboBoxItem>04</ComboBoxItem><ComboBoxItem>05</ComboBoxItem><ComboBoxItem>06</ComboBoxItem><ComboBoxItem>07</ComboBoxItem>
                                    <ComboBoxItem>08</ComboBoxItem><ComboBoxItem>09</ComboBoxItem><ComboBoxItem>10</ComboBoxItem><ComboBoxItem>11</ComboBoxItem>
                                    <ComboBoxItem>12</ComboBoxItem><ComboBoxItem>13</ComboBoxItem><ComboBoxItem>14</ComboBoxItem><ComboBoxItem>15</ComboBoxItem>
                                    <ComboBoxItem>16</ComboBoxItem><ComboBoxItem>17</ComboBoxItem><ComboBoxItem>18</ComboBoxItem><ComboBoxItem>19</ComboBoxItem>
                                    <ComboBoxItem>20</ComboBoxItem><ComboBoxItem>21</ComboBoxItem><ComboBoxItem>22</ComboBoxItem><ComboBoxItem>23</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="时" Grid.Column="3" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="3,0,0,0"/>
                                <ComboBox x:Name="EditReminderMin" Grid.Column="5" Height="36" SelectedIndex="0">
                                    <ComboBoxItem>00</ComboBoxItem><ComboBoxItem>05</ComboBoxItem><ComboBoxItem>10</ComboBoxItem><ComboBoxItem>15</ComboBoxItem>
                                    <ComboBoxItem>20</ComboBoxItem><ComboBoxItem>25</ComboBoxItem><ComboBoxItem>30</ComboBoxItem><ComboBoxItem>35</ComboBoxItem>
                                    <ComboBoxItem>40</ComboBoxItem><ComboBoxItem>45</ComboBoxItem><ComboBoxItem>50</ComboBoxItem><ComboBoxItem>55</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="分" Grid.Column="6" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="3,0,0,0"/>
                            </Grid>
                            <WrapPanel>
                                <Button Content="5分钟后" Click="FormQuickReminder_Click" Tag="5"
                                        Cursor="Hand" FontSize="11" Height="26" Padding="8,0" Margin="0,0,6,4"
                                        Background="White" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="8,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="30分钟后" Click="FormQuickReminder_Click" Tag="30"
                                        Cursor="Hand" FontSize="11" Height="26" Padding="8,0" Margin="0,0,6,4"
                                        Background="White" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="8,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="1小时后" Click="FormQuickReminder_Click" Tag="60"
                                        Cursor="Hand" FontSize="11" Height="26" Padding="8,0" Margin="0,0,6,4"
                                        Background="White" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="8,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="明早9点" Click="FormQuickReminder_Click" Tag="tomorrow9"
                                        Cursor="Hand" FontSize="11" Height="26" Padding="8,0"
                                        Background="White" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="8,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Confirm Button -->
                    <Button Grid.Row="9" Content="✓ 确定" Click="EditSave_Click"
                            Height="44" FontSize="15" FontWeight="SemiBold" Margin="20,0,20,12"
                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#D4687B"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Border>

        <!-- ===== Calendar Popup ===== -->
        <Border x:Name="CalendarPopup" Visibility="Collapsed" Panel.ZIndex="999"
                Background="#80000000" MouseLeftButtonDown="CalendarPopupBg_Click">
            <Border Width="360" MaxHeight="520" Background="White" CornerRadius="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
                </Border.Effect>
                <Grid Margin="16,14,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Month Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Button Content="‹" Click="PrevMonth_Click"
                                Height="30" Width="30" FontSize="18" FontWeight="Bold" Cursor="Hand"
                                Background="Transparent" Foreground="#999"
                                BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="CalMonthLabel" Text="2026年6月" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="今天" Click="Today_Click"
                                    Height="28" FontSize="11" Cursor="Hand" Margin="0,0,6,0"
                                    Background="{StaticResource SurfaceBrush}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Padding="10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="10,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="›" Click="NextMonth_Click"
                                    Height="30" Width="30" FontSize="18" FontWeight="Bold" Cursor="Hand"
                                    Background="Transparent" Foreground="#999"
                                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Subtle divider -->
                    <Border Grid.Row="1" Height="1" Background="#0FD4687B" Margin="0,2,0,6"/>

                    <!-- Month Calendar Grid -->
                    <Grid x:Name="MonthGrid" Grid.Row="2"/>

                    <!-- Today's tasks list -->
                    <Border Grid.Row="3" Background="{StaticResource BgBrush}" CornerRadius="10" Padding="10,8" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="CalTodayLabel" Text="今天" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="CalTodayTasks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="6" Padding="6,4" Margin="0,0,0,3">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                        Background="{Binding ColorBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===== Confirm Dialog ===== -->
        <Border x:Name="ConfirmPanel" Visibility="Collapsed" Panel.ZIndex="1001"
                Background="#80000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="300" Background="White" CornerRadius="18" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" Text="确认操作" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ConfirmText" Text="" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Click="ConfirmCancel_Click"
                                Height="34" MinWidth="68" FontSize="13" Cursor="Hand"
                                Background="{StaticResource SurfaceBrush}" BorderThickness="0" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="17" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="确定" Click="ConfirmOk_Click"
                                Height="34" MinWidth="68" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                Foreground="White" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#EF4444" CornerRadius="17" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
